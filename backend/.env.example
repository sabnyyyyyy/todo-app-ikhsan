PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=todo_app_backend

# Ganti dengan string acak yang panjang, misalnya hasil:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_secret_acak_yang_panjang
JWT_EXPIRES_IN=1d

# Daftar origin frontend yang diizinkan, pisahkan dengan koma
CORS_ORIGIN=http://localhost:3000
