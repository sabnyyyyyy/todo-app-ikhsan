            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "3. Post Todo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task\": \"Mengerjakan Tugas #6 Backend\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/todos"
          }
        },
        {
          "name": "4. Get Todos (page=1&perPage=5)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/todos?page=1&perPage=5",
              "host": ["{{base_url}}"],
              "path": ["api", "todos"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "perPage", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "5. 404 Handler",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/tidak-ada"
          }
        }
      ]
    }
  ]
}
